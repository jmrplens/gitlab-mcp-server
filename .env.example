# gitlab-mcp-server — Environment variables template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# In CI/CD, configure these as pipeline variables instead.

# GitLab connection (required)
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_MCP_SKIP_TLS_VERIFY=false

# Docker Container Registry (required for docker-publish scripts)
DOCKER_REGISTRY=ghcr.io/jmrplens/gitlab-mcp-server

# Licensed Docker e2e run (optional; requires a valid license). The target
# chooses the run now, `make test-e2e-ee`, so there is no variable that turns
# it on: these two only say which image to boot and what to activate it with.
# GITLAB_IMAGE=gitlab/gitlab-ee:latest
# ENTERPRISE_LICENSE=your-enterprise-license-key

# Bitbucket Cloud import e2e (optional). When all four are set,
# TestBitbucketCloudImport_Individual performs a REAL import via the
# bitbucket_api_token + bitbucket_email auth path (and cleans up the project);
# otherwise it falls back to a routing + graceful-error test. Treat the token as
# a secret — never commit it (put real values in .env, which is gitignored).
# BITBUCKET_API_TOKEN=ATATT3x...                 # Atlassian API token
# BITBUCKET_EMAIL=you@example.com                # email tied to the token
# BITBUCKET_USERNAME=your-bitbucket-username     # Bitbucket/Atlassian username
# BITBUCKET_REPO_PATH=your-workspace/your-repo   # source repo to import

# Multi-model evaluation harness (optional; used by cmd/eval_mcp_surfaces)
# This is the one model list: scripts/eval-surfaces-docker.sh keeps none of its own
# and passes --models only when EVAL_SURFACE_MODELS is set, so what is written here
# is what runs. Adjust model IDs to the provider's current exact names.
# The Google alias resolves to the latest Gemini Flash model available to the API key,
# so two runs a month apart are not necessarily the same model.
# All four names below were accepted by the provider adapters as they stand, on
# 2026-09-15. Two OpenAI names that were tried and are NOT usable with the adapter as
# written: the gpt-5.6 family (luna, sol) refuses function tools on
# /v1/chat/completions unless the request carries reasoning_effort: none, which the
# adapter has no field for, and gpt-5.5 refuses the temperature 0 the adapter always
# sends. Verify any other name against the adapter before writing it here.
EVAL_MODELS=anthropic:claude-haiku-4-5-20251001,google:gemini-flash-latest,openai:gpt-5.4-nano,qwen:qwen3.8-flash
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key
QWEN_API_KEY=your-qwen-api-key

# --- E2E external importer credentials (optional) ---
# Exercise the admin importer e2e coverage (TestAdmin_ExternalImporters and
# TestBitbucketCloudImport_Individual) against the real third-party services.
# Those scenarios also need E2E_EXTERNAL_NETWORK=true, which is the opt-in for
# any test that calls a public URL; without it they skip whatever is set here.
# GH_TOKEN drives import_github / import_cancel_github / import_gists (a
# repository owned by the token's user is resolved automatically); the
# BITBUCKET_* set drives the Bitbucket Cloud import; the BITBUCKET_SERVER_* set
# targets a self-hosted Bitbucket Server if you have one reachable. In Docker
# mode (make test-e2e-ce) the BITBUCKET_SERVER_* values are auto-provisioned by
# the ephemeral Bitbucket fixture and written to test/e2e/.env.docker — only
# fill them here for self-hosted runs.
GH_TOKEN=
BITBUCKET_USERNAME=
BITBUCKET_API_TOKEN=
BITBUCKET_EMAIL=
BITBUCKET_REPO_PATH=
BITBUCKET_SERVER_URL=
BITBUCKET_SERVER_USERNAME=
BITBUCKET_SERVER_TOKEN=
BITBUCKET_SERVER_PROJECT_KEY=
BITBUCKET_SERVER_REPO_SLUG=
