# gitlab-mcp-server — Environment variables template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# In CI/CD, configure these as pipeline variables instead.

# GitLab connection (required)
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_SKIP_TLS_VERIFY=false

# Docker Container Registry (required for docker-publish scripts)
DOCKER_REGISTRY=ghcr.io/jmrplens/gitlab-mcp-server

# GitLab Enterprise Docker tests (optional; requires a valid license)
# GITLAB_ENTERPRISE=true
# GITLAB_IMAGE=gitlab/gitlab-ee:latest
# ENTERPRISE_LICENSE=your-enterprise-license-key

# Bitbucket Cloud import e2e (optional). When all four are set,
# TestIndividual_BitbucketCloudImport_APIToken performs a REAL import via the
# bitbucket_api_token + bitbucket_email auth path (and cleans up the project);
# otherwise it falls back to a routing + graceful-error test. Treat the token as
# a secret — never commit it (put real values in .env, which is gitignored).
# BITBUCKET_API_TOKEN=ATATT3x...                 # Atlassian API token
# BITBUCKET_EMAIL=you@example.com                # email tied to the token
# BITBUCKET_USERNAME=your-bitbucket-username     # Bitbucket/Atlassian username
# BITBUCKET_REPO_PATH=your-workspace/your-repo   # source repo to import

# Multi-model evaluation harness (optional; used by cmd/eval_mcp_surfaces)
# Adjust model IDs to the provider's current exact names before running tests.
# The Google alias resolves to the latest Gemini Flash model available to the API key.
EVAL_MODELS=anthropic:claude-haiku-4-5-20251001,google:gemini-flash-latest,openai:gpt-5.4-nano,qwen:qwen3.6-flash
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
OPENAI_API_KEY=your-openai-api-key
QWEN_API_KEY=your-qwen-api-key
