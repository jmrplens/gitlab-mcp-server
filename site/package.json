{
  "name": "gitlab-mcp-server-docs",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/normalize-html.mjs && node scripts/add-sitemap-lastmod.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "contrast:check": "node scripts/check-contrast.mjs",
    "chips:check": "node scripts/check-chips.mjs",
    "facts:check": "node scripts/check-facts.mjs",
    "identity:sync": "node scripts/sync-identity.mjs",
    "identity:check": "node scripts/sync-identity.mjs --check",
    "eslint": "eslint .",
    "html-validate": "html-validate 'dist/**/*.html'",
    "htmlhint": "htmlhint 'dist/**/*.html'",
    "pa11y": "astro preview & sleep 3 && pa11y-ci; EXIT=$?; kill %1 2>/dev/null; exit $EXIT",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run check && pnpm run contrast:check && pnpm run chips:check && pnpm run facts:check && pnpm run i18n:check && pnpm run llms:check && pnpm run eslint && pnpm run format:check && pnpm run html-validate && pnpm run htmlhint && pnpm run a11y:check",
    "test:a11y": "pnpm run pa11y",
    "analyze": "pnpm run build && pnpm run lint",
    "prebuild": "node scripts/gen-llms.mjs",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "llms:check": "node scripts/gen-llms.mjs --check",
    "a11y:check": "node scripts/check-headings-labels.mjs"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/starlight": "^0.41.11",
    "astro": "^7.2.10",
    "mermaid": "^11.17.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "html-validate": "^11.12.0",
    "htmlhint": "^1.9.2",
    "pa11y-ci": "^4.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "rehype-mermaid": "^3.0.0",
    "starlight-links-validator": "^0.25.3",
    "typescript": "^6.0.3"
  }
}
