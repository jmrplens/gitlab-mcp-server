{
  "name": "gitlab-mcp-server-docs",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/normalize-html.mjs && node scripts/add-sitemap-lastmod.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "contrast:check": "node scripts/check-contrast.mjs",
    "chips:check": "node scripts/check-chips.mjs",
    "facts:check": "node scripts/check-facts.mjs",
    "identity:sync": "node scripts/sync-identity.mjs",
    "identity:check": "node scripts/sync-identity.mjs --check",
    "eslint": "eslint .",
    "html-validate": "html-validate 'dist/**/*.html'",
    "htmlhint": "htmlhint 'dist/**/*.html'",
    "pa11y": "astro preview & sleep 3 && pa11y-ci; EXIT=$?; kill %1 2>/dev/null; exit $EXIT",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run check && pnpm run contrast:check && pnpm run chips:check && pnpm run facts:check && pnpm run i18n:check && pnpm run eslint && pnpm run format:check && pnpm run html-validate && pnpm run htmlhint && pnpm run a11y:check",
    "test:a11y": "pnpm run pa11y",
    "analyze": "pnpm run build && pnpm run lint",
    "prebuild": "node scripts/copy-llms.mjs",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "a11y:check": "node scripts/check-headings-labels.mjs"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/starlight": "^0.41.10",
    "astro": "^7.2.9",
    "mermaid": "^11.17.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "html-validate": "^11.10.0",
    "htmlhint": "^1.9.2",
    "pa11y-ci": "^4.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "rehype-mermaid": "^3.0.0",
    "starlight-links-validator": "^0.25.3",
    "typescript": "^6.0.3"
  }
}
