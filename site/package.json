{
  "name": "gitlab-mcp-server-docs",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.0+sha512.8f64efa0b792986ca98ae568791bcd7722807e274c4f0c1d9853c62116495c584119db98762a2a5343b1684d361b9ae26fdd16d551666d7635346d3fae830ddd",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/normalize-html.mjs && node scripts/add-sitemap-lastmod.mjs && node scripts/check-version-token.mjs --dist",
    "preview": "astro preview",
    "check": "astro check",
    "contrast:check": "node scripts/check-contrast.mjs",
    "chips:check": "node scripts/check-chips.mjs",
    "facts:check": "node scripts/check-facts.mjs",
    "eslint": "eslint .",
    "html-validate": "html-validate 'dist/**/*.html'",
    "htmlhint": "htmlhint 'dist/**/*.html'",
    "pa11y": "astro preview & sleep 3 && pa11y-ci; EXIT=$?; kill %1 2>/dev/null; exit $EXIT",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run check && pnpm run contrast:check && pnpm run chips:check && pnpm run facts:check && pnpm run i18n:check && pnpm run llms:check && pnpm run version:check && pnpm run eslint && pnpm run format:check && pnpm run html-validate && pnpm run htmlhint && pnpm run a11y:check",
    "test:a11y": "pnpm run pa11y",
    "analyze": "pnpm run build && pnpm run lint",
    "prebuild": "node scripts/gen-llms.mjs",
    "i18n:check": "node scripts/check-i18n-parity.mjs && node scripts/check-i18n-code.mjs",
    "llms:check": "node scripts/gen-llms.mjs --check",
    "version:check": "node scripts/check-version-token.mjs",
    "a11y:check": "node scripts/check-headings-labels.mjs"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/starlight": "^0.42.6",
    "astro": "^7.3.8",
    "mermaid": "^12.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "html-validate": "^11.16.2",
    "htmlhint": "^1.9.2",
    "pa11y-ci": "^4.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "rehype-mermaid": "^3.0.0",
    "starlight-links-validator": "^0.26.0",
    "typescript": "^6.0.3"
  }
}
