---
/**
 * One benchmark figure, in the reader's theme.
 *
 * The charts are generated by `cmd/bench_resources` as a light and a dark SVG
 * per figure, per language, under `public/benchmarks/<lang>/`. Both are placed
 * here and CSS decides which one is visible, because an `<img>` cannot follow
 * the site's theme toggle on its own: `prefers-color-scheme` inside the file
 * would answer the operating system's question rather than the one the reader
 * pressed, and the two disagree the moment anybody uses the switch. This is the
 * same reason SiteTitle.astro inlines the mark instead of linking it.
 *
 * The dark copy is decorative: it carries the same information as the light
 * one, so it takes an empty alt and is hidden from assistive technology rather
 * than described twice.
 *
 * Sizing is stated on the elements so the page does not reflow when the files
 * land; the figures are all drawn on the same 900x500 canvas, whose last
 * twenty pixels are the host and build each figure carries along its bottom
 * edge (see `chartH` in cmd/bench_resources/chart.go).
 */
interface Props {
	/** Figure name, without the scheme or extension. */
	name: string;
	/** Language directory the figure was rendered into: "en" or "es". */
	lang: string;
	/** Alternative text, generated in the same language as the figure. */
	alt: string;
}

const { name, lang, alt } = Astro.props;
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "");
const light = `${base}/benchmarks/${lang}/${name}.light.svg`;
const dark = `${base}/benchmarks/${lang}/${name}.dark.svg`;
---

<figure class="gm-chart">
	<img
		class="gm-chart-img gm-chart-light"
		src={light}
		alt={alt}
		width="900"
		height="500"
		loading="lazy"
		decoding="async"
	/>
	<img
		class="gm-chart-img gm-chart-dark"
		src={dark}
		alt=""
		aria-hidden="true"
		width="900"
		height="500"
		loading="lazy"
		decoding="async"
	/>
</figure>

<style>
	.gm-chart {
		margin: 1.5rem 0;
		padding: 0;
		overflow-x: auto;
	}

	.gm-chart-img {
		display: block;
		width: 100%;
		height: auto;
		max-width: 900px;
		border: 1px solid var(--gm-border);
		border-radius: var(--gm-radius);
	}

	/* Light is the default so a reader with no theme attribute yet, or with
	   scripting off, still sees one chart rather than both. */
	.gm-chart-dark {
		display: none;
	}

	:global([data-theme="dark"]) .gm-chart-light {
		display: none;
	}

	:global([data-theme="dark"]) .gm-chart-dark {
		display: block;
	}
</style>
